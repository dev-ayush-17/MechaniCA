rules_version = '2';

// Golden rule (docs/prd/10-hybrid-backend.md): clients may read where noted.
// Only FastAPI (Admin SDK, which bypasses these rules) writes booking status,
// prices, payments, wallet, coupons, rating aggregates, and verification.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
      match /notifications/{id} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
      match /{sub=**} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    match /bookings/{id} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.mechanicId == request.auth.uid
      );
      allow write: if false;
      match /messages/{mid} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/bookings/$(id)).data.customerId
            == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(id)).data.mechanicId
            == request.auth.uid
        );
        allow write: if false;
      }
    }

    match /idempotencyKeys/{id} { allow read, write: if false; }

    match /payments/{id} { allow read, write: if false; }
    match /invoices/{id} { allow read, write: if false; }
    match /coupons/{id} { allow read, write: if false; }
    match /couponRedemptions/{id} { allow read, write: if false; }
    match /ledger/{id} { allow read, write: if false; }
    match /wallets/{id} { allow read, write: if false; }
    match /auditLog/{id} { allow read, write: if false; }

    match /mechanics/{mechanicId} {
      allow read: if signedIn();
      // ratingAvg and ratingCount are server-only caches (FR-REV-004).
      allow write: if false;
      match /documents/{docId} {
        allow read: if isSelf(mechanicId);
        allow write: if false;
      }
    }

    match /bookings/{bookingId}/proofs/{proofId} {
      allow read: if signedIn() && (
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId
          == request.auth.uid ||
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.mechanicId
          == request.auth.uid
      );
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /serviceCatalog/{code} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /offers/{offerId} {
      allow read: if signedIn() && resource.data.mechanicId == request.auth.uid;
      allow write: if false;
    }

    // Deny anything not listed above.
    match /{document=**} { allow read, write: if false; }
  }
}
