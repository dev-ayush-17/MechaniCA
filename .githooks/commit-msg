#!/bin/sh
# Conventional Commits: type(scope): summary, subject at most 72 characters.
subject=$(head -n 1 "$1")

case "$subject" in
  "Merge "*|"Revert \""*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must look like 'type(scope): imperative summary'." >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert." >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters. Keep it to 72 or fewer." >&2
  exit 1
fi
