# Copy to .env for local runs. Never commit .env.
MECHUPP_APP_ENV=dev
MECHUPP_LOG_LEVEL=INFO
MECHUPP_PROVIDER_READINESS=fake
# fake works only when APP_ENV is dev or test. Phone OTP needs Blaze + PROVIDER_AUTH=firebase.
MECHUPP_PROVIDER_AUTH=fake
MECHUPP_PROVIDER_USERS=fake
MECHUPP_PROVIDER_ADDRESSES=fake
MECHUPP_PROVIDER_VEHICLES=fake
MECHUPP_PROVIDER_CATALOG=fake
MECHUPP_PROVIDER_BOOKINGS=fake
MECHUPP_PROVIDER_MECHANICS=fake
MECHUPP_PROVIDER_OFFERS=fake
# Override dispatch timings. Dev defaults wait 10 min and keep offers 3 min.
# MECHUPP_DISPATCH_NORMAL_TTL_SECONDS=180
# MECHUPP_DISPATCH_WAIT_SECONDS=600
# MECHUPP_DISPATCH_SWEEP_INTERVAL_SECONDS=8
# MECHUPP_DEMO_WALLET_FLOAT=true
MECHUPP_PROVIDER_NOTIFICATIONS=fake
MECHUPP_PROVIDER_CHAT=fake
MECHUPP_PROVIDER_LOCATION=fake
# MECHUPP_FIREBASE_PROJECT_ID=mechupp-staging
# MECHUPP_FIREBASE_DATABASE_URL=https://mechupp-staging-default-rtdb.firebaseio.com
# MECHUPP_FIREBASE_CREDENTIALS=serviceAccount.json
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# MECHUPP_CASHFREE_APP_ID=
# MECHUPP_CASHFREE_SECRET=
# MECHUPP_GOOGLE_MAPS_SERVER_KEY=
# MECHUPP_GSTIN=22AAAAA0000A1Z5
