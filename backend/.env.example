# Copy to .env for local runs. Never commit .env.
MECHANICA_APP_ENV=dev
MECHANICA_LOG_LEVEL=INFO
MECHANICA_PROVIDER_READINESS=fake
# fake works only when APP_ENV is dev or test. Use firebase with the emulator or a real project.
MECHANICA_PROVIDER_AUTH=fake
