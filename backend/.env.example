# Copy to .env for local runs. Never commit .env.
MECHUPP_APP_ENV=dev
MECHUPP_LOG_LEVEL=INFO
MECHUPP_PROVIDER_READINESS=fake
# fake works only when APP_ENV is dev or test. Use firebase with the emulator or a real project.
MECHUPP_PROVIDER_AUTH=fake
